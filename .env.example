# LLM (Ollama par défaut — local-first)
OLLAMA_BASE_URL=http://localhost:11434
# Optionnel : clé API Ollama (modèles cloud) — https://ollama.com/settings/keys
# Si la clé est définie, les appels /api/* vont sur https://ollama.com (doc officielle).
OLLAMA_API_KEY=
# Optionnel : forcer l'URL des appels API (ex. http://localhost:11434) au lieu de la détection auto
OLLAMA_API_HTTP_BASE=
LLM_MODEL=gpt-oss:120b-cloud
LLM_PROVIDER=ollama
# Option llama.cpp (désactivé par défaut)
LLAMACPP_MODEL_PATH=
LLAMACPP_N_CTX=4096

# Embeddings (SentenceTransformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Vector DB
VECTOR_DB=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legaldoc_morocco
CHROMA_PATH=./app/data/processed/chroma

# Reranking (optionnel, plus lourd au démarrage)
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chemins
DATA_DIR=./app/data

# CORS (origines frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP client externe (désactivé par défaut)
MCP_EXTERNAL_ENABLED=false
MCP_EXTERNAL_COMMAND=
